# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8
*.p12
*.cer
*.mobileprovision
*.keychain
*.keychain-db

# app store / mobile build artifacts
*.ipa
*.aab
*.apk
*.idsig
*.xcarchive
ios/App/output*/
ios/App/build/
ios/App/Pods/
android/app/build/
android/app/release/
android/.gradle/
android/local.properties
twa-build/

# handover/signing bundles must stay out of git
deployment_handover/
apple-signing/
app-store-connect/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large binary / audio files (excluded - too large for GitHub)
public/audio/
*.m4a
*.mp3
*.wav
